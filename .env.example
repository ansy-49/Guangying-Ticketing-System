# Copy this file to .env before running docker compose.
# Do not commit your real .env.

MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=guangying
MYSQL_USER=guangying
MYSQL_PASSWORD=change-me-app-password

JWT_SECRET=change-me-to-a-random-256-bit-jwt-secret-at-least-32-chars

REDIS_HOST=redis
REDIS_PORT=6379
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876

# 仅当后端只允许可信 Nginx/网关访问时开启代理 IP 请求头解析。
RATE_LIMIT_TRUST_PROXY_HEADERS=true

# 热门场次同时持有准入租约的人数；超出后才进入 Waiting Room。
# 2000 是集群参考基线，正式环境必须根据容量压测校准。
QUEUE_DEFAULT_MAX_ADMISSION=2000
QUEUE_MAX_ADMISSION_UPPER_BOUND=20000

# 单个热门场次的等待队列硬上限，用于吸收开售洪峰并限制 Redis 内存占用。
QUEUE_MAX_WAITING=100000

# 订单超时主链路使用 RocketMQ 定时消息；以下参数只控制数据库补偿扫描。
ORDER_TIMEOUT_SCAN_INTERVAL_MS=60000
ORDER_TIMEOUT_SCAN_BATCH_SIZE=100
ORDER_TIMEOUT_SCAN_MAX_BATCHES=10

# Outbox 发送租约与自动重试上限。
OUTBOX_CLAIM_SECONDS=30
OUTBOX_MAX_RETRIES=10

# Optional production HTTPS settings. If you use the bundled nginx/certbot files,
# replace example.com in docker/nginx/*.conf or template them in your own deploy flow.
DEPLOY_DOMAIN=example.com
CERT_EMAIL=admin@example.com
